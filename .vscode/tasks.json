{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Set up (first time)",
      "type": "shell",
      "windows": { "command": "py -3.12 -m venv .venv; .venv\\Scripts\\python -m pip install -r requirements-dev.txt" },
      "command": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements-dev.txt",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "windows": { "command": ".venv\\Scripts\\python -m pytest -q" },
      "command": ".venv/bin/python -m pytest -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Build Windows app (.exe)",
      "type": "shell",
      "windows": { "command": ".venv\\Scripts\\pyinstaller --noconfirm stjparts.spec" },
      "command": "echo The Windows build only runs on Windows",
      "problemMatcher": []
    }
  ]
}
